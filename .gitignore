# ==============================================================================
# PYTHON & VIRTUAL ENVIRONMENTS
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Distribution / Packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ==============================================================================
# DATA DIRECTORIES (IGNORE DATA PAYLOADS, PRESERVE FOLDER STRUCTURE)
# ==============================================================================
# Ignore all raw and processed dataset files...
data/raw/*
data/processed/*

# ...except for the .gitkeep files so empty directories are tracked
!data/raw/.gitkeep
!data/processed/.gitkeep

# Ignore standalone dataset dumps if generated in root
*.csv
*.parquet
*.feather
*.json
*.sqlite3

# ==============================================================================
# STREAMLIT & DASHBOARD CACHE
# ==============================================================================
.streamlit/secrets.toml

# ==============================================================================
# JUPYTER NOTEBOOKS & LOGS
# ==============================================================================
.ipynb_checkpoints
*.ipynb_checkpoints/
*.log

# ==============================================================================
# IDE & OS SPECIFIC FILES
# ==============================================================================
# VS Code
.vscode/

# PyCharm / IntelliJ
.idea/

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# Windows
Thumbs.db
desktop.ini